# Porta em que a aplicação escuta.
# Padrão do projeto: 3002 (a 3000 costuma estar ocupada por outros containers).
# Se alterar, ajuste também o mapeamento "ports" do serviço "app" no docker-compose.yml.
PORT=3002

# Conexão com o PostgreSQL.
# DB_HOST=db é o nome do serviço no docker-compose.yml (rede interna do Docker).
# Rodando fora do Docker, use DB_HOST=localhost.
DB_HOST=db
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=biblioteca

# CONFIGURAÇÃO PRISMA
DATABASE_URL=postgresql://admin:sua_senha@localhost:5433/biblioteca

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório).
JWT_SECRET=

# CONFIGURAÇÃO DE E-MAIL (SMTP)
# Deixe SMTP_HOST vazio em desenvolvimento para usar a conta de teste
# automática (Ethereal) — o link do e-mail sai como URL de preview no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Biblioteca Interna <nao-responda@biblioteca.local>"

# URL base usada para montar o link de redefinição no e-mail.
APP_URL=http://localhost:3002