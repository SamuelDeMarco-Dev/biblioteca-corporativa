{
  "name": "biblioteca-interna",
  "version": "1.0.0",
  "description": "Sistema web para gerenciamento de biblioteca interna com cadastro, locação, devolução de livros, permissões de usuários, dashboard administrativo e integração com Open Library API.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "jest"
  },
  "keywords": [
    "biblioteca",
    "nodejs",
    "mvc",
    "postgresql",
    "docker",
    "open-library"
  ],
  "author": "Samuel De Marco",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
